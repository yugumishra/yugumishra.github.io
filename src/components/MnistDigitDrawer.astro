---
const modelUrl = '/models/mnist-decoder/model.json';
const latentUrl = '/models/mnist-latent.json';
---

<div
  class="mnist-demo"
  data-mnist-demo
  data-model-url={modelUrl}
  data-latent-url={latentUrl}
>
  <button
    class="button mnist-open"
    type="button"
    data-mnist-open
    aria-expanded="false"
    aria-controls="mnist-panel"
  >
    Open digit drawer
  </button>

  <div class="mnist-panel" id="mnist-panel" data-mnist-panel hidden>
    <div class="mnist-output">
      <canvas
        data-mnist-canvas
        width="28"
        height="28"
        role="img"
        aria-label="Generated MNIST digit"
      ></canvas>
      <p class="mnist-status" data-mnist-status aria-live="polite">
        Loading decoder…
      </p>
    </div>

    <div class="mnist-controls">
      <div class="mnist-slider-grid" data-mnist-sliders></div>
      <button class="button mnist-reset" type="button" data-mnist-reset>
        Reset sliders
      </button>
    </div>
  </div>
</div>

<script>
  interface LatentSpace {
    sliderMin: number;
    sliderMax: number;
    sliderStep: number;
    mean: number[];
    basis: number[][];
    scales: number[];
    axisOrder: number[];
  }

  const root = document.querySelector<HTMLElement>('[data-mnist-demo]');

  if (root) {
    const openButton = root.querySelector<HTMLButtonElement>('[data-mnist-open]');
    const panel = root.querySelector<HTMLElement>('[data-mnist-panel]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-mnist-canvas]');
    const status = root.querySelector<HTMLElement>('[data-mnist-status]');
    const sliders = root.querySelector<HTMLElement>('[data-mnist-sliders]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-mnist-reset]');
    const modelUrl = root.dataset.modelUrl;
    const latentUrl = root.dataset.latentUrl;

    let runtime: any;
    let decoder: any;
    let latentSpace: LatentSpace | null = null;
    let loadPromise: Promise<void> | null = null;
    let renderScheduled = false;
    let renderVersion = 0;

    const setStatus = (message: string, busy = false) => {
      if (status) status.textContent = message;
      root.toggleAttribute('aria-busy', busy);
    };

    const readSliderValues = () =>
      Array.from(
        root.querySelectorAll<HTMLInputElement>('[data-latent-slider]'),
      ).map((slider) => Number(slider.value));

    const toLatentVector = (sliderValues: number[], data: LatentSpace) => {
      const scaled = sliderValues.map((value, index) => value * data.scales[index]);

      return data.mean.map((meanValue, row) =>
        meanValue + data.basis[row].reduce(
          (sum, basisValue, column) => sum + basisValue * scaled[column],
          0,
        ),
      );
    };

    const drawDigit = (pixels: Float32Array | Int32Array | Uint8Array) => {
      if (!canvas) return;
      const context = canvas.getContext('2d');
      if (!context) return;

      const image = context.createImageData(28, 28);
      for (let index = 0; index < 28 * 28; index += 1) {
        const value = Math.round(
          Math.max(0, Math.min(1, Number(pixels[index]))) * 255,
        );
        const offset = index * 4;
        image.data[offset] = value;
        image.data[offset + 1] = value;
        image.data[offset + 2] = value;
        image.data[offset + 3] = 255;
      }

      context.imageSmoothingEnabled = false;
      context.putImageData(image, 0, 0);
    };

    const render = async () => {
      if (!runtime || !decoder || !latentSpace) return;
      const version = ++renderVersion;
      const latentVector = toLatentVector(readSliderValues(), latentSpace);
      const prediction = runtime.tidy(() => {
        const input = runtime.tensor2d([latentVector], [1, 16]);
        return decoder.predict(input);
      });

      try {
        const pixels = await prediction.data();
        if (version === renderVersion) drawDigit(pixels);
      } finally {
        prediction.dispose();
      }
    };

    const queueRender = () => {
      if (renderScheduled || !decoder) return;
      renderScheduled = true;
      requestAnimationFrame(() => {
        renderScheduled = false;
        void render();
      });
    };

    const buildSliders = (data: LatentSpace) => {
      if (!sliders) return;
      sliders.replaceChildren();

      data.axisOrder.forEach((dimension, axis) => {
        const label = document.createElement('label');
        label.className = 'mnist-slider';

        const heading = document.createElement('span');
        heading.className = 'mnist-slider-label';
        heading.textContent = `z${dimension}`;
        heading.title = `Latent Dim ${dimension}`;

        const value = document.createElement('output');
        value.className = 'mnist-slider-value';
        value.textContent = '0.00';

        const input = document.createElement('input');
        input.type = 'range';
        input.min = String(data.sliderMin);
        input.max = String(data.sliderMax);
        input.step = String(data.sliderStep);
        input.value = '0';
        input.dataset.latentSlider = String(axis);
        input.setAttribute('aria-label', `Latent Dim ${dimension}`);
        input.addEventListener('input', () => {
          value.textContent = Number(input.value).toFixed(2);
          queueRender();
        });

        label.append(heading, input, value);
        sliders.append(label);
      });
    };

    const loadModel = async () => {
      if (loadPromise) return loadPromise;
      if (!modelUrl || !latentUrl) throw new Error('MNIST model URLs are missing');

      loadPromise = (async () => {
        const [tf, latentResponse] = await Promise.all([
          import('@tensorflow/tfjs'),
          fetch(latentUrl),
        ]);
        if (!latentResponse.ok) {
          throw new Error(`Latent metadata request failed (${latentResponse.status})`);
        }

        runtime = tf;
        await runtime.ready();
        latentSpace = (await latentResponse.json()) as LatentSpace;
        decoder = await runtime.loadLayersModel(modelUrl);
        buildSliders(latentSpace);
        await render();
      })();

      try {
        await loadPromise;
      } catch (error) {
        loadPromise = null;
        throw error;
      }
    };

    openButton?.addEventListener('click', async () => {
      if (!panel || !openButton) return;
      const opening = panel.hidden;
      panel.hidden = !opening;
      openButton.setAttribute('aria-expanded', String(opening));
      openButton.textContent = opening ? 'Close digit drawer' : 'Open digit drawer';
      if (!opening || decoder) return;

      setStatus('Loading decoder…', true);
      openButton.disabled = true;
      try {
        await loadModel();
        setStatus('Ready · drag a slider to change the digit');
      } catch (error) {
        console.error('Unable to load the MNIST decoder', error);
        setStatus('The decoder could not load. Try again.');
        panel.hidden = true;
        openButton.setAttribute('aria-expanded', 'false');
        openButton.textContent = 'Open digit drawer';
      } finally {
        openButton.disabled = false;
      }
    });

    resetButton?.addEventListener('click', () => {
      root.querySelectorAll<HTMLInputElement>('[data-latent-slider]').forEach(
        (slider) => {
          slider.value = '0';
          slider.parentElement?.querySelector('output')?.replaceChildren('0.00');
        },
      );
      queueRender();
    });
  }
</script>
