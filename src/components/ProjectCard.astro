---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import MnistDigitDrawer from './MnistDigitDrawer.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  blurb: string;
  bullets: string[];
  href: string | null;
  ariaLabel?: string | null;
  revealHeading?: string | null;
  image?: ImageMetadata | null;
  imageAlt?: string;
  /** Public-path GIF (Astro doesn't optimize GIFs). */
  gif?: string | null;
  /** Video sources, used in place of a heavy GIF. */
  video?: { mp4: string; webm: string; poster: ImageMetadata } | null;
  /**
   * A second clip of the same moment, revealed beneath `video` when the card
   * expands and kept in step with it. Both files must share a duration and
   * frame rate, or they drift apart at the loop boundary.
   */
  syncedVideo?: {
    mp4: string;
    webm: string;
    poster: ImageMetadata;
    caption: string;
  } | null;
  contain?: boolean;
  callout?: { text: string; linkText: string; href: string } | null;
  interactive?: boolean;
  featured?: boolean;
  status?: string | null;
  technologies?: string[];
  blogHref?: string | null;
  stills?: { image: ImageMetadata; alt: string; caption: string; contain?: boolean }[];
}

const {
  title,
  blurb,
  bullets,
  href,
  ariaLabel,
  revealHeading = 'Accomplishments',
  image = null,
  imageAlt = '',
  gif = null,
  video = null,
  syncedVideo = null,
  contain = false,
  callout = null,
  interactive = false,
  featured = false,
  status = null,
  technologies = [],
  blogHref = null,
  stills = [],
} = Astro.props;

// Bullets of the form "Tools: X, Y" keep their bolded label, as in the original.
const split = (b: string) => {
  const m = b.match(/^(Tools:)\s*(.*)$/s);
  return m ? { label: m[1], rest: m[2] } : { label: null, rest: b };
};

const featuredBullets = bullets.filter((b) => !/^Tools:\s*/.test(b));
const toolBullet = bullets.find((b) => /^Tools:\s*/.test(b));
const techItems =
  technologies.length > 0
    ? technologies
    : toolBullet
      ? toolBullet
          .replace(/^Tools:\s*/, '')
          .split(',')
          .map((item) => item.trim())
          .filter(Boolean)
      : [];
const detailId = `project-detail-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article id={interactive ? 'mnist-digit-drawer' : undefined} class:list={['project', { featured, 'project-expandable': !featured, 'is-mnist': interactive, 'has-synced': !!syncedVideo }]}>
  <div class:list={['media', { contain }]}>
    <figure class="media-slide">
    {
      video ? (
        <video
          loop
          muted
          playsinline
          preload="none"
          data-play-in-view
          poster={video.poster.src}
          aria-label={imageAlt}
          data-sync-primary={syncedVideo ? '' : undefined}
        >
          <source src={video.webm} type="video/webm" />
          <source src={video.mp4} type="video/mp4" />
        </video>
      ) : gif ? (
        <img src={gif} alt={imageAlt} loading="lazy" decoding="async" />
      ) : image ? (
        <Image src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : null
    }
    </figure>
    {stills.map((still) => (
      <figure class:list={['media-slide', { contain: still.contain }]} hidden>
        <Image src={still.image} alt={still.alt} loading="lazy" decoding="async" />
        <figcaption>{still.caption}</figcaption>
      </figure>
    ))}
    {stills.length > 0 && (
      <div class="media-controls" hidden>
        <button type="button" class="media-prev" aria-label={`Previous ${title} image`}>‹</button>
        <span class="media-count" aria-live="polite">1 / {stills.length + 1}</span>
        <button type="button" class="media-next" aria-label={`Next ${title} image`}>›</button>
      </div>
    )}
    {syncedVideo && (
      <figure class="media-synced">
        {/* preload="none": ~370KB that only matters once the card is opened. */}
        <video
          loop
          muted
          playsinline
          preload="none"
          poster={syncedVideo.poster.src}
          aria-label={syncedVideo.caption}
          data-sync-secondary
        >
          <source src={syncedVideo.webm} type="video/webm" />
          <source src={syncedVideo.mp4} type="video/mp4" />
        </video>
        <figcaption>{syncedVideo.caption}</figcaption>
      </figure>
    )}
    {interactive && <MnistDigitDrawer />}
  </div>

  <div class="body">
    {featured && status && <p class="project-status">{status}</p>}
    <h3>{title}</h3>
    <p class="blurb">{blurb}</p>

    {interactive && (
      <div class="mnist-demo">
        <div class="mnist-demo-copy">
          <p class="mnist-demo-kicker">Interactive model</p>
          <p>Explore the VAE's 16-dimensional latent space and generate a digit.</p>
        </div>
        <button class="button mnist-open" type="button" aria-controls={detailId}>
          Open full-size digit drawer
        </button>
      </div>
    )}

    {
      featured && (
        <>
          <ul class="featured-bullets">
            {
              featuredBullets.map((b) => {
                const { label, rest } = split(b);
                return (
                  <li>
                    {label && <b>{label}</b>} {rest}
                  </li>
                );
              })
            }
          </ul>

          {
            techItems.length > 0 && (
              <ul class="tech-list" aria-label="Technologies used">
                {techItems.map((item) => <li>{item}</li>)}
              </ul>
            )
          }
        </>
      )
    }

    {
      callout && !featured && (
        <p class="callout">
          <Icon name="pen" size={15} />
          <span>
            {callout.text}{' '}
            <a href={callout.href} target="_blank" rel="noopener">
              {callout.linkText}
            </a>
          </span>
        </p>
      )
    }

    {!featured && (
      <>
        <button type="button" class="project-detail-toggle" aria-expanded="false" aria-controls={detailId}>
          <span>In detail</span>
          <Icon name="chevron" size={15} class="chev" />
        </button>
        <div class="project-detail" id={detailId} hidden>
          <h4>{revealHeading}</h4>
          <ul>
            {bullets.map((b) => {
              const { label, rest } = split(b);
              return <li>{label && <b>{label}</b>} {rest}</li>;
            })}
          </ul>
        </div>
      </>
    )}

    {
      (href || blogHref) && (
        <div class="links">
          {
            href && (
              <a class="button" href={href} target="_blank" rel="noopener" aria-label={ariaLabel ?? undefined}>
                <Icon name="external" size={14} /> View project on GitHub
              </a>
            )
          }
          {
            blogHref && (
              <a class="button" href={blogHref} target="_blank" rel="noopener">
                <Icon name="external" size={14} /> Read the Yope3D blog
              </a>
            )
          }
        </div>
      )
    }
  </div>
</article>
