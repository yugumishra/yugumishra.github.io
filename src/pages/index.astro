---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import content from '../data/content.json';
import yope from '../data/yope.json';

const { hero, about, experience, papers, projects, skills, education, contact } =
  content;

const titleFor = (id: string) =>
  content.section_titles.find((s) => s.id === id)?.title ?? '';

// ---- image resolution -------------------------------------------------------
// Static images are optimized by Astro; GIFs live in /public/media untouched.
const globbed = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/*.{png,jpg,jpeg,webp,svg}',
  { eager: true },
);
const byName = new Map(
  Object.entries(globbed).map(([p, m]) => [p.split('/').pop()!, m.default]),
);

const img = (src: string | null | undefined): ImageMetadata | null => {
  if (!src) return null;
  let name = src.split('/').pop()!;
  if (name === 'th.jfif') name = 'th.jpg'; // JFIF renamed so Astro recognizes it
  return byName.get(name) ?? null;
};

// Add screenshots to a project's `stills` array in content.json. Files go in
// src/assets/img so Astro can optimize them; captions appear in the expanded card.
type ProjectStill = { img: string; alt: string; caption: string; contain?: boolean };
const projectStills = (stills: ProjectStill[]) =>
  stills.map((still) => {
    const image = img(still.img);
    if (!image) throw new Error(`Project still not found: ${still.img}`);
    return { image, alt: still.alt, caption: still.caption, contain: still.contain };
  });

const poster = byName.get('yope_cloth_poster.jpg')!;
const glyphPoster = byName.get('glyph_poster.jpg')!;
const glyphClassifierPoster = byName.get('glyph_classifier_poster.jpg')!;

// PDFs moved from assets/papers/ to public/papers/, so the extracted hrefs
// (which preserve the legacy paths) need remapping to their served location.
const docHref = (href: string | null) =>
  href ? href.replace(/^\/?assets\/papers\//, '/papers/') : href;

// ---- Yope3D card ------------------------------------------------------------
// Copy is lifted verbatim from YOPE3D_readme.md (see src/data/yope.json); the
// legacy card still described the retired Java/LWJGL engine.
const f = yope.features;
const yopeBullets = [
  'Tools: C++20, Vulkan, Python, CMake, Catch2',
  f['Physics'][0],
  f['Rendering Capabilities'][0],
  f['Scripting'][0],
  f['Tooling & tests'][2],
];

// Per-project media wiring, keyed by the original card title. `video` carries
// its own sources: two projects ship video now, so a boolean would have played
// the wrong clip.
type CardVideo = { mp4: string; webm: string; poster: ImageMetadata };
const MEDIA: Record<
  string,
  {
    gif?: string;
    video?: CardVideo;
    /** Second clip, revealed under the first when the card expands. */
    syncedVideo?: CardVideo & { caption: string };
    contain?: boolean;
  }
> = {
  Yope3D: {
    video: {
      mp4: '/media/yope_cloth_b.mp4',
      webm: '/media/yope_cloth_b.webm',
      poster,
    },
  },
  // Both clips are the same take: gesture_test.bin [19.05s, 28.05s], 270
  // frames at 30fps, cut frame-aligned so they stay in sync across loops.
  GlyphInterpreter: {
    video: {
      mp4: '/media/glyph_demo.mp4',
      webm: '/media/glyph_demo.webm',
      poster: glyphPoster,
    },
    syncedVideo: {
      mp4: '/media/glyph_classifier.mp4',
      webm: '/media/glyph_classifier.webm',
      poster: glyphClassifierPoster,
      caption:
        'The same take, scored frame by frame: distance to the nearest enrolled gesture against the threshold (dashed).',
    },
  },
  'MNIST Beta VAE': { gif: '/media/digit_animation.gif' },
  SpinStack: { gif: '/media/spinstack_demo.gif' },
  'Java AI': { contain: true },
  'Polynomial Root Solver': { contain: true },
  '3D Gravity Simulator': { gif: '/media/3d_grav_b_3.gif' },
};

// Full-width cards, rendered above the grid.
const FEATURED = ['Yope3D'];
const yopeProject = projects.find((project) => project.title === 'Yope3D');
const projectOrder = [
  'GlyphInterpreter',
  'SpinStack',
  'MNIST Beta VAE',
  'Java AI',
  '3D Gravity Simulator',
  'Polynomial Root Solver',
];
const otherProjects = projects
  .filter((project) => !FEATURED.includes(project.title))
  .sort((a, b) => projectOrder.indexOf(a.title) - projectOrder.indexOf(b.title));

// The phone number is deliberately not published; it was also purged from git
// history. Email and GitHub remain.
const contactRows = contact.filter((c) => !(c.icon ?? '').includes('fa-phone'));

const ICON_FOR_CONTACT = (icon: string | null) =>
  (icon ?? '').includes('github') ? 'github' : 'mail';
---

<Base>
  {/* ---------------- intro ---------------- */}
  <section id="intro" class="section">
    <div class="wrap hero">
      <h1>
        {hero.greeting_prefix} <span class="name">{hero.greeting_name}</span>
      </h1>
      <p class="tagline">{hero.tagline}</p>
      <p class="typed-line">
        <span class="typed-prefix">{hero.typed_prefix}</span>
        <span class="typing" id="typing"></span><span class="caret"></span>
      </p>

      <div class="social">
        {
          hero.social.map((s) => (
            <a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label="GitHub profile">
              <Icon name="github" size={19} />
            </a>
          ))
        }
      </div>

      <div class="buttons">
        {
          hero.buttons.map((b, i) => (
            <a
              class:list={['button', { primary: i === 0 }]}
              href={b.href}
              target={b.label === 'Resume' ? '_blank' : undefined}
              rel={b.label === 'Resume' ? 'noopener' : undefined}
            >
              {b.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------- about ---------------- */}
  <section id="about" class="section">
    <div class="wrap about">
      <h2 class="page-title">{titleFor('about')}</h2>
      {about.paragraphs.map((p) => <p>{p}</p>)}
      {
        about.lists.map((list) => (
          <ul class="facts">
            {list.map((item) => (
              <li>
                <b>{item.label}</b>
                {item.value}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  {/* ---------------- experience ---------------- */}
  <section id="experience" class="section">
    <div class="wrap">
      <h2 class="page-title">{titleFor('experience')}</h2>
      <div class="stack">
        {
          experience.map((e) => (
            <article class="card">
              <div class="exp-head">
                <h3>
                  {e.href ? (
                    <a href={e.href} target="_blank" rel="noopener">
                      {e.org}
                    </a>
                  ) : (
                    e.org
                  )}
                </h3>
                <span class="exp-role">{e.role}</span>
              </div>
              <ul>
                {e.bullets.map((b) => {
                  const m = b.match(/^(Tools:)\s*(.*)$/s);
                  return <li>{m ? <><b>{m[1]}</b> {m[2]}</> : b}</li>;
                })}
              </ul>
              <p class="exp-date">{e.date}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------- papers ---------------- */}
  <section id="papers" class="section">
    <div class="wrap">
      <h2 class="page-title">{titleFor('papers')}</h2>
      <div class="grid-2">
        {
          papers.map((p) => {
            const src = img(p.img);
            const contain = (p.img_style ?? '').includes('contain');
            return (
              <article class="paper">
                <a class:list={['thumb', { contain }]} href={docHref(p.href)} target="_blank" rel="noopener">
                  {src && <Image src={src} alt={p.img_alt ?? ''} loading="lazy" decoding="async" />}
                </a>
                <div class="body">
                  <a href={docHref(p.href)} target="_blank" rel="noopener">{p.title}</a>
                  <p class="venue">{p.venue}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ---------------- projects ---------------- */}
  <section id="projects" class="section">
    <div class="wrap">
      <h2 class="page-title">{titleFor('projects')}</h2>
      {
        yopeProject && (
          <ProjectCard
            title={yopeProject.title}
            blurb={yope.tagline}
            bullets={yopeBullets}
            href={yopeProject.href}
            ariaLabel={yopeProject.aria_label}
            image={null}
            imageAlt="Yope3D cloth simulation running in the engine"
            video={MEDIA.Yope3D.video}
            featured
            status={yope.status}
            technologies={['C++20', 'Vulkan', 'Python', 'CMake', 'Catch2']}
            blogHref={yope.blog}
          />
        )
      }


      <div class="grid-3 project-grid">
        {
          otherProjects.map((p) => {
            const media = MEDIA[p.title] ?? {};
            return (
              <ProjectCard
                title={p.title}
                blurb={p.blurb}
                bullets={p.bullets}
                href={p.href}
                ariaLabel={p.aria_label}
                revealHeading={p.reveal_heading}
                image={media.gif || media.video ? null : img(p.img)}
                imageAlt={p.img_alt ?? p.title}
                gif={media.gif ?? null}
                video={media.video ?? null}
                syncedVideo={media.syncedVideo ?? null}
                contain={media.contain ?? false}
                interactive={p.title === 'MNIST Beta VAE'}
                stills={projectStills(p.stills as ProjectStill[])}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ---------------- skills ---------------- */}
  <section id="skills" class="section">
    <div class="wrap">
      <h2 class="page-title">{titleFor('skills')}</h2>
      {
        skills.groups.map((g) => (
          <div class="card skills-card">
            <h3>{g.heading}</h3>
            <div class="skill-grid">
              {g.items.map((item) => {
                const src = img(item.img);
                return (
                  <div class="skill">
                    {src && <Image src={src} alt={item.img_alt ?? item.name} loading="lazy" decoding="async" />}
                    <p>{item.name}</p>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
      {
        skills.certificates.length > 0 && (
          <div class="card skills-card">
            <h3>Certificates</h3>
            <div class="cert-list">
              {skills.certificates.map((c) => (
                <div class="cert">{c}</div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* ---------------- education ---------------- */}
  <section id="education" class="section">
    <div class="wrap">
      <h2 class="page-title">{titleFor('education')}</h2>
      <div class="grid-2">
        {
          education.map((e) => (
            <article class="card edu">
              <h3>
                {e.href ? (
                  <a href={e.href} target="_blank" rel="noopener">{e.school}</a>
                ) : (
                  e.school
                )}
              </h3>
              <p class="loc">{e.location}</p>
              <p class="degree">
                {e.degree_lines.map((line) => {
                  const m = line.match(/^([^:]+:)\s*(.*)$/s);
                  return (
                    <>
                      {m ? <><b>{m[1]}</b> {m[2]}</> : line}
                      <br />
                    </>
                  );
                })}
              </p>
              {e.blocks.map((b) => (
                <div class="block">
                  <b>{b.label}</b>
                  <ul>
                    {b.items.map((i) => <li>{i}</li>)}
                  </ul>
                </div>
              ))}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------- contact ---------------- */}
  <section id="contact" class="section">
    <div class="wrap">
      <h2 class="page-title">{titleFor('contact')}</h2>
      <div class="contact-list">
        {
          contactRows.map((c) => (
            <a class="contact-row" href={c.href} target={c.href?.startsWith('mailto') ? undefined : '_blank'} rel="noopener" aria-label={c.aria_label}>
              <Icon name={ICON_FOR_CONTACT(c.icon)} size={19} />
              <span>{c.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ strings: content.hero.typed_strings }}>
  // Replaces typed.js (~20 lines vs. a vendored library), matching the blog's
  // zero-dependency stance. Honors prefers-reduced-motion.
  const el = document.getElementById('typing');
  if (el && strings.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      el.textContent = strings[0];
    } else {
      const shuffle = (items, avoidFirst) => {
        const shuffled = [...items];

        for (let index = shuffled.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(Math.random() * (index + 1));
          [shuffled[index], shuffled[swapIndex]] = [
            shuffled[swapIndex],
            shuffled[index],
          ];
        }

        // A new permutation can still begin with the previous permutation's
        // final word. Swap it away when there is another option.
        if (avoidFirst && shuffled.length > 1 && shuffled[0] === avoidFirst) {
          const swapIndex = shuffled.findIndex(
            (word, index) => index > 0 && word !== avoidFirst,
          );
          if (swapIndex > 0) {
            [shuffled[0], shuffled[swapIndex]] = [
              shuffled[swapIndex],
              shuffled[0],
            ];
          }
        }

        return shuffled;
      };

      let order = shuffle(strings);
      let i = 0, j = 0, deleting = false;
      const tick = () => {
        const word = order[i];
        el.textContent = word.slice(0, j);
        if (!deleting && j < word.length) j++;
        else if (deleting && j > 0) j--;
        else if (!deleting) { deleting = true; setTimeout(tick, 1400); return; }
        else {
          deleting = false;
          if (i === order.length - 1) {
            order = shuffle(strings, word);
            i = 0;
          } else {
            i++;
          }
        }
        setTimeout(tick, deleting ? 30 : 60);
      };
      tick();
    }
  }
</script>

<script>
  const grid = document.querySelector<HTMLElement>('.project-grid');
  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.project-expandable'));
    const originalOrder = [...cards];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let selectionRun = 0;

    // Animate both the selected card and the cards whose rows move around it.
    // The DOM order follows the visual order, so keyboard navigation stays sane.
    const rearrange = (selected: HTMLElement | null) => {
      const run = ++selectionRun;
      cards.forEach((card) => card.getAnimations().forEach((animation) => animation.cancel()));
      const before = new Map(cards.map((card) => [card, card.getBoundingClientRect()]));
      cards.forEach((card) => {
        const expanded = card === selected;
        card.classList.toggle('is-expanded', expanded);
        clipPairs.get(card)?.(expanded);
        const toggle = card.querySelector<HTMLButtonElement>('.project-detail-toggle');
        const detail = card.querySelector<HTMLElement>('.project-detail');
        toggle?.setAttribute('aria-expanded', String(expanded));
        if (toggle) toggle.querySelector('span')!.textContent = expanded ? 'Show less' : 'In detail';
        if (detail) detail.hidden = !expanded;
        if (!expanded) {
          card.dataset.slide = '0';
          card.querySelectorAll<HTMLElement>('.media-slide').forEach((slide, index) => { slide.hidden = index !== 0; });
          const controls = card.querySelector<HTMLElement>('.media-controls');
          if (controls) controls.hidden = true;
          const count = card.querySelector<HTMLElement>('.media-count');
          if (count) count.textContent = `1 / ${card.querySelectorAll('.media-slide').length}`;
        } else {
          const controls = card.querySelector<HTMLElement>('.media-controls');
          if (controls) controls.hidden = false;
        }
      });

      if (selected) grid.prepend(selected);
      else originalOrder.forEach((card) => grid.append(card));
      selected?.dispatchEvent(new Event('project:expanded'));

      const animations: Animation[] = [];
      if (reducedMotion.matches) {
        selected?.scrollIntoView({ behavior: 'auto', block: 'start' });
        return;
      }
      cards.forEach((card) => {
        const first = before.get(card)!;
        const last = card.getBoundingClientRect();
        if (!first.width || !last.width) return;
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        const sx = first.width / last.width;
        const sy = first.height / last.height;
        if (Math.abs(dx) + Math.abs(dy) + Math.abs(sx - 1) + Math.abs(sy - 1) < 0.01) return;
        animations.push(card.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
            { transform: 'translate(0, 0) scale(1, 1)' },
          ],
          { duration: 420, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        ));
      });
      if (selected) {
        void Promise.allSettled(animations.map((animation) => animation.finished)).then(() => {
          if (run === selectionRun) selected.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    };

    // A card can carry a second clip of the same take, revealed on expand. The
    // files are cut to the same frame range, duration and rate, so they only
    // need nudging back together when decoding jitters — but `loop` restarts
    // each element independently, so the comparison has to wrap around the
    // duration or every loop boundary reads as a full-length drift.
    const pairClips = (card: HTMLElement) => {
      const primary = card.querySelector<HTMLVideoElement>('[data-sync-primary]');
      const secondary = card.querySelector<HTMLVideoElement>('[data-sync-secondary]');
      if (!primary || !secondary) return () => {};

      const TOLERANCE = 0.08;
      let timer = 0;

      const realign = () => {
        const span = primary.duration;
        if (!span || Number.isNaN(span)) return;
        let delta = secondary.currentTime - primary.currentTime;
        if (delta > span / 2) delta -= span;
        if (delta < -span / 2) delta += span;
        if (Math.abs(delta) > TOLERANCE) secondary.currentTime = primary.currentTime;
      };

      return (expanded: boolean) => {
        window.clearInterval(timer);
        if (!expanded) {
          secondary.pause();
          return;
        }
        secondary.currentTime = primary.currentTime;
        void secondary.play().catch(() => {});
        realign();
        timer = window.setInterval(realign, 500);
      };
    };

    const clipPairs = new Map(cards.map((card) => [card, pairClips(card)]));

    // The cards' clips load and play only while they are near the viewport;
    // until then their posters stand in. Reduced motion keeps the posters.
    const stillOnly = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const inView = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting && !stillOnly) {
          video.preload = 'auto';
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    }, { rootMargin: '200px 0px' });
    document.querySelectorAll<HTMLVideoElement>('video[data-play-in-view]').forEach((video) => inView.observe(video));

    cards.forEach((card) => {
      card.querySelector<HTMLButtonElement>('.project-detail-toggle')?.addEventListener('click', () => {
        rearrange(card.classList.contains('is-expanded') ? null : card);
      });
      card.querySelector<HTMLButtonElement>('.mnist-open')?.addEventListener('click', () => {
        rearrange(card);
      });

      const slides = Array.from(card.querySelectorAll<HTMLElement>('.media-slide'));
      if (slides.length < 2) return;
      const count = card.querySelector<HTMLElement>('.media-count');
      card.dataset.slide = '0';
      const show = (next: number) => {
        const current = (next + slides.length) % slides.length;
        card.dataset.slide = String(current);
        slides.forEach((slide, index) => { slide.hidden = index !== current; });
        if (count) count.textContent = `${current + 1} / ${slides.length}`;
        clipPairs.get(card)?.(card.classList.contains('is-expanded') && current === 0);
      };
      card.querySelector('.media-prev')?.addEventListener('click', () => show(Number(card.dataset.slide) - 1));
      card.querySelector('.media-next')?.addEventListener('click', () => show(Number(card.dataset.slide) + 1));

      const media = card.querySelector<HTMLElement>('.media');
      let touchX: number | null = null;
      media?.addEventListener('touchstart', (event) => {
        touchX = event.changedTouches[0]?.screenX ?? null;
      }, { passive: true });
      media?.addEventListener('touchend', (event) => {
        if (touchX === null || !card.classList.contains('is-expanded')) return;
        const delta = (event.changedTouches[0]?.screenX ?? touchX) - touchX;
        if (Math.abs(delta) > 45) show(Number(card.dataset.slide) + (delta < 0 ? 1 : -1));
        touchX = null;
      }, { passive: true });
    });

    // The hero's Fun Stuff link still opens the interactive MNIST project.
    document.querySelector<HTMLAnchorElement>('a[href="#mnist-digit-drawer"]')?.addEventListener('click', (event) => {
      const mnist = grid.querySelector<HTMLElement>('#mnist-digit-drawer');
      if (!mnist) return;
      event.preventDefault();
      rearrange(mnist);
    });
    if (window.location.hash === '#mnist-digit-drawer') {
      const mnist = grid.querySelector<HTMLElement>('#mnist-digit-drawer');
      if (mnist) rearrange(mnist);
    }
  }
</script>
